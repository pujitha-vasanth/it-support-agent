# Copy this file to .env and fill in your OpenAI key.
# The .env file is git-ignored, so your key never leaves your machine.

OPENAI_API_KEY=sk-replace-me

# Models. Run `python scripts/check_setup.py` to confirm your account can use these.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-4o-mini

# Database (matches docker-compose.yml; change only if you changed that file)
DATABASE_URL=postgresql://itsupport:itsupport@localhost:5433/itsupport

# Retrieval tuning
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
RERANK_TOP_K=5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Set to "fake" to run the whole pipeline with no API key and no cost.
# Useful for a smoke test. Answers will be nonsense; retrieval still works.
PROVIDER=openai
